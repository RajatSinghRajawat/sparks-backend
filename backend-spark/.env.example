# ─── Server Configuration ───
PORT=5000
NODE_ENV=production
DOMAIN=api.sparks-learning.com

# ─── Database ───
# For local MongoDB container/service: mongodb://127.0.0.1:27017/eduspark
# For MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/eduspark
MONGO_URI=mongodb://127.0.0.1:27017/eduspark

# ─── Security / Authentication ───
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# ─── SMTP Email Configuration ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ─── AWS S3 Storage Config ───
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET=your_s3_bucket_name
